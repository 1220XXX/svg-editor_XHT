# scenario: promote
init
create g p
create g a in p
create g inner in p
create g b in inner
create g c in inner
create g d in p
ungroup inner
tree
undo
show b
ungroup p
redo

# scenario: default-inheritance
init
create g outer
create g inner in outer
set inner fill "red"
create rect r 1 2 3 4 in inner
ungroup inner
show r
