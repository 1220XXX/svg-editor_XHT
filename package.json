{
  "name": "svg-cli-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Object-oriented SVG editor — Lab1 Phase 1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cli": "node --import tsx src/bootstrap/Main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bootstrap/Main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
